import { setupDevPlatform } from "@cloudflare/next-on-pages/next-dev";

/** @type {import('next').NextConfig} */
const nextConfig = {
  reactStrictMode: true,
  // Required for @cloudflare/next-on-pages
  experimental: {
    // Enables partial pre-rendering compatible with Cloudflare Pages
  },
  // Disable image optimisation (not supported on Cloudflare Pages edge)
  images: { unoptimized: true },
};

// Enable Cloudflare dev bindings in local `next dev`
if (process.env.NODE_ENV === "development") {
  await setupDevPlatform().catch(() => {
    // @cloudflare/next-on-pages not installed yet — skip silently
  });
}

export default nextConfig;
