# =============================================================
# TypingSkillZone — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# =============================================================

# Neon PostgreSQL — existing application data stays in this database.
DATABASE_URL=postgres://user:password@ep-xxxx.ap-south-1.aws.neon.tech/neondb?sslmode=require

# Neon Auth — copy the Auth URL from Neon Console → your project → Auth.
# This must be the complete Neon Auth base URL, including its /auth path.
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.region.aws.neon.build/neondb/auth
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-xxxx.neonauth.region.aws.neon.build/neondb/auth

# Cashfree Payments
CF_MERCHANT_ID=cf_test_xxxxxxxxxxxx
CF_SECRET_KEY=cf_secret_xxxxxxxxxxxx
CF_WEBHOOK_SECRET=webhook_secret_xxxxxxxxxxxx

# Optional price overrides in paise (100 paise = ₹1)
PRO_MONTHLY_PAISE=9900
PRO_YEARLY_PAISE=79900

# Optional AI feedback
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
