# Typing Skill Zone — current deployment configuration
# Copy to .env.local for local development. Never commit real credentials.

# Neon PostgreSQL application database. Must be the database with public.users,
# subscriptions, payments, institutions, tests, results, exam_templates, etc.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require

# Neon Auth URL copied from the Neon Console for the SAME project/environment.
# Use the complete API base URL shown by Neon; do not guess the hostname.
NEON_AUTH_BASE_URL=https://YOUR-NEON-AUTH-URL/auth
NEXT_PUBLIC_NEON_AUTH_URL=https://YOUR-NEON-AUTH-URL/auth
NEXT_PUBLIC_URL=https://typingskillzone.in

# Cashfree Payment Gateway (PG). Start in sandbox mode for testing.
# CF_MERCHANT_ID is Cashfree's App ID / Client ID.
CF_ENVIRONMENT=sandbox
CF_MERCHANT_ID=YOUR_CASHFREE_SANDBOX_APP_ID
CF_SECRET_KEY=YOUR_CASHFREE_SANDBOX_SECRET_KEY

# Optional AI feedback
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
