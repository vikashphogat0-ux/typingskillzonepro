# =============================================================
# TypingSkillZone — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# =============================================================

# ── Neon PostgreSQL ───────────────────────────────────────────
# Create a project at https://neon.tech → Connection Details
# Format: postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=postgres://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ── Custom auth (no external auth library) ────────────────────
# Passwords are hashed with pgcrypto (bcrypt, cost 10).
# Sessions are random hex tokens stored in the `sessions` table.
# BETTER_AUTH_URL is used only to build password-reset links.
BETTER_AUTH_URL=http://localhost:3000

# ── Resend / Neon Auth mail (recommended) ─────────────────────
# Instead of Resend, set these Neon-Auth variables so password
# reset links and verification emails arrive automatically.
NEON_AUTH_BASE_URL=https://typingskillzone.in
NEXT_PUBLIC_NEON_AUTH_URL=https://typingskillzone.in
RESEND_API_KEY=
EMAIL_FROM="TypingSkillZone <no-reply@typingskillzone.in>"

# ── Cashfree Payments ─────────────────────────────────────────
# Start with test keys from https://dashboard.cashfree.com/
# Webhook URL: https://typingskillzone.in/api/webhook
# Cashfree Payment Engine v1 signature uses X-Cashfree-Signature
# base64(HMAC_SHA256(secret, "/order/v1/orders\n" + ts + "\n" + body)).
CF_MERCHANT_ID=cf_test_xxxxxxxxxxxx
CF_SECRET_KEY=cf_secret_xxxxxxxxxxxx
CF_WEBHOOK_SECRET=webhook_secret_xxxxxxxxxxxx

# Optional: price overrides in paise (100 paise = ₹1)
# Defaults: ₹99/month, ₹799/year
PRO_MONTHLY_PAISE=9900
PRO_YEARLY_PAISE=79900

# ── Groq AI feedback (optional) ──────────────────────────────
# Get a free key at https://console.groq.com/keys
# Leave blank to disable AI feedback (coaching notes remain available)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile